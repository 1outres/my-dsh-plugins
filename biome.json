{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/lib",
      "!pnpm-lock.yaml",
      "!**/coverage",
      "!**/.claude",
      "!**/.worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
