{
  "name": "@1outres/dsh-plugins",
  "version": "0.4.0",
  "description": "Personal DeepSeek Harness plugin bundle. Installs every plugin in this repository.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1outres/my-dsh-plugins.git",
    "directory": "packages/dsh-plugins"
  },
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/creator-ptc.patch.yml": "./presets/creator-ptc.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@1outres/dsh-plugin-background": "workspace:*",
    "@1outres/dsh-plugin-notify": "workspace:*",
    "@1outres/dsh-plugin-claude-subscription": "workspace:*",
    "@1outres/dsh-plugin-model-picker": "workspace:*",
    "@1outres/dsh-plugin-edit-message": "workspace:*",
    "@1outres/dsh-plugin-scratchpad": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/creator-ptc.patch.yml"
      ]
    }
  }
}
