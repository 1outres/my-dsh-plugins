{
  "name": "@1outres/dsh-plugin-playwright",
  "version": "0.7.0",
  "description": "Gives each top-level DSH session its own isolated Playwright browser context, with browser automation tools from Playwright MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1outres/my-dsh-plugins.git",
    "directory": "packages/dsh-plugin-playwright"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "playwright",
    "browser",
    "automation",
    "deepseek-harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.85",
    "playwright": "1.66.0-alpha-2026-11-09"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  }
}
